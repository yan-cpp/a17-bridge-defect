{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "A17: Doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "a17",
      "args": [
        "doctor"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "justMyCode": true
    },
    {
      "name": "A17: Validate Config",
      "type": "debugpy",
      "request": "launch",
      "module": "a17",
      "args": [
        "validate-config"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      },
      "justMyCode": true
    }
  ]
}
